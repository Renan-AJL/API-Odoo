# ============================================================
# CONFIGURACAO DO MIDDLEWARE UNIFICADO - Itau + CNP Ja
# ============================================================

# --- AUTENTICACAO UNIFICADA ---
# Uma unica API Key protege TODAS as rotas (Itau e CNP Ja)
MIDDLEWARE_API_KEY=gerar-uma-chave-secreta-super-forte-aqui

# --- PORTA ---
PORT=3000

# --- RATE LIMIT ---
RATE_LIMIT_PER_MINUTE=60

# --- DEBUG ---
DEBUG=false

# ============================================================
# ITAU - BOLETOS / PIX
# ============================================================

# Ambiente: sandbox ou producao
AMBIENTE=producao

# Credenciais OAuth2 Itau
ITAU_CLIENT_ID=seu-client-id-itau
ITAU_CLIENT_SECRET=seu-client-secret-itau

# PIX
ITAU_PIX_CHAVE=email@suaempresa.com.br

# Dados bancarios
ITAU_AGENCIA=7764
ITAU_CONTA=22338-9
ITAU_ID_BENEFICIARIO=776400223389
ITAU_CARTEIRA=109

# Certificados mTLS (producao) - coloque o conteudo PEM direto
ITAU_CERT_CRT=
ITAU_CERT_KEY=

# Mock mode (true para testar sem o Itau)
MOCK_MODE=false

# URLs customizadas (opcional - preenchidas automaticamente por AMBIENTE)
# ITAU_TOKEN_URL=https://sts.itau.com.br/api/oauth/token
# ITAU_BOLECODE_URL=https://api.itau.com.br/cash_management/v2
# ITAU_PIX_URL=https://api.itau.com.br/pix/v2

# ============================================================
# ODOO - XML-RPC Push
# ============================================================

ODOO_PUSH_ENABLED=true
ODOO_URL=https://seu-empresa.odoo.com
ODOO_DB=seu-empresa
ODOO_USERNAME=seu-email@empresa.com
ODOO_API_KEY=sua-api-key-do-odoo

# ============================================================
# CNP JA - CONSULTA CNPJ
# ============================================================

# Token da API comercial (opcional - sem ele usa API publica sem IE)
CNPJA_API_TOKEN=

# URL base (opcional - preenchida automaticamente baseado no token)
# CNPJA_API_BASE=https://api.cnpja.com

CNPJA_TIMEOUT=15000

# Token Consultar.IO para IE via SINTEGRA (opcional)
CONSULTAR_IO_TOKEN=
# ============================================================
# SIEG - NF-e / NFS-e
# ============================================================

SIEG_CLIENT_ID=
SIEG_CLIENT_SECRET=
SIEG_OAUTH_TOKEN=
SIEG_API_KEY=
SIEG_CALLBACK_URL=https://sua-api.onrender.com/callback/sieg

# Ambiente da NF-e: 1=producao, 2=homologacao (sandbox)
SIEG_TP_AMB=2

# --- Responsavel Tecnico (grupo infRespTec, OBRIGATORIO na NF-e 4.00) ---
NFE_RESP_TEC_CNPJ=
NFE_RESP_TEC_CONTATO=
NFE_RESP_TEC_EMAIL=
NFE_RESP_TEC_FONE=

# --- Reforma Tributaria (IBS/CBS) ---
# true (padrao) gera cMunFGIBS, IBSCBS por item, IBSCBSTot e vNFTot
NFE_IBSCBS=true
NFE_P_IBS_UF=0.10
NFE_P_IBS_MUN=0.00
NFE_P_CBS=0.90

# Indicador de presenca padrao (9 = nao presencial, outros)
NFE_IND_PRES=9

# --- Emissao propria com certificado digital A1 (sem depender da SIEG) ---
# proprio (padrao) = assina com o A1 e autoriza direto na SEFAZ
# sieg             = apenas importa no cofre SIEG um XML ja autorizado
NFE_EMISSAO_MODO=proprio
# UF do emitente (define o webservice da SEFAZ). Ex.: PR, SP, SVRS para as demais
NFE_UF=PR
# Diretorio persistente do certificado. No Render, crie um Disk montado em /var/data
NFE_CERT_DIR=/var/data
# Chave usada para cifrar a senha do certificado em disco (qualquer string forte)
NFE_CERT_KEK=
# Fallback opcional: certificado por variavel de ambiente (.pfx em base64 + senha)
NFE_CERT_PFX_BASE64=
NFE_CERT_SENHA=
# DANFE: local (padrao, gerado pela propria API) ou sieg
NFE_DANFE_PROVIDER=local
# 1 = apos autorizar na SEFAZ, tambem importa o XML no cofre da SIEG
SIEG_IMPORT_XML=0
