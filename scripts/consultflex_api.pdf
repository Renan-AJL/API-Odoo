let reqBody = 
  let uri = Uri.of_string "https://api.consultflex.com.br/json/service.aspx" in
  let headers = Header.init ()
    |> fun h -> Header.add h "Content-Type" "application/json"
  in
  let body = Cohttp_lwt.Body.of_string !postData in

