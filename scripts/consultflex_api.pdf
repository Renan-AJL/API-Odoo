        Try
            Dim stringJson As String
            stringJson = "{"
            stringJson += "\"CodigoProduto\": \"34\","
            stringJson += "\"Versao\": \"20180521\","
            stringJson += "\"ChaveAcesso\": \"ZzM67lS3CL7SSW6680p9fEcNPcD5wE88aSQa/D3EnDeL6cnwsrkpmrCsSt4dssftiiooSega\","
            stringJson += "\"Parametros\": {"
            stringJson += "      \"TipoPessoa\": \"J\","
            stringJson += "	    \"CPFCNPJ\": \"77973317000139\""
            stringJson += "	  }"
            stringJson += "}" 

            Dim objRequest As HttpWebRequest = CType(WebRequest.Create("https://api.consultflex.com.br/json/service.aspx"), HttpWebRequest)
            objRequest.Method = "POST"
            Dim encoding As New System.Text.ASCIIEncoding()
            Dim byte1 As Byte() = System.Text.Encoding.UTF8.GetBytes(stringJson)
            objRequest.ContentLength = byte1.Length
            objRequest.ContentType = "application/json"
            objRequest.KeepAlive = False
            Dim streamToSend As Stream = objRequest.GetRequestStream()
            streamToSend.Write(byte1, 0, byte1.Length)
            streamToSend.Close()
            Dim objResponse As HttpWebResponse = objRequest.GetResponse()
            Dim StreamReader As StreamReader
            StreamReader = New StreamReader(objResponse.GetResponseStream())
            Return StreamReader.ReadToEnd()
        Catch e As Exception
            Return "Error"
        End Try
 
     



